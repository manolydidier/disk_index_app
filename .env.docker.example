# Config for `docker compose up` — NOT the same file as .env / .env.example,
# which are for running the app natively (DATABASE_URL there points at
# localhost; here it must resolve to the "db" service on the compose network).
#
# Copy this to .env.docker and fill in real values. docker compose picks up
# a file named exactly ".env" automatically — either rename this to .env in
# the deployment checkout, or run compose with `--env-file .env.docker`.

# --- Postgres (used to build DATABASE_URL for the app service too) ---
POSTGRES_USER="disk_indexer"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="disk_indexer"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Reachable URL of this server, e.g. http://192.168.1.50:3000
NEXTAUTH_URL=""

# --- Agent auth ---
# Shared secret agents present when registering — must match what each
# agent's own config uses. Generate with: openssl rand -base64 32
AGENT_REGISTRATION_SECRET=""

# --- App ---
APP_NAME="Disk Indexer"
SCAN_MAX_CONCURRENCY="16"

# --- Email (optional — can also be configured later in Paramètres > Automatisation) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Optional overrides ---
# DISABLE_AUTOMATION_DAEMON="true"
# PRISMA_ACCEPT_DATA_LOSS="true"
