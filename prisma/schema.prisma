generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiskStatus {
  ACTIVE
  INACTIVE
  DISCONNECTED
}

enum EntryType {
  FILE
  FOLDER
}

enum ScanType {
  FULL
  DIFFERENTIAL
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ActivityType {
  ADDED
  MODIFIED
  DELETED
  RENAMED
  DISK_STATUS
}

enum AutomationEventType {
  NEW_DISK_DETECTED
  DISK_CHANGED
}

enum AutomationActionState {
  PENDING
  ACCEPTED
  DISMISSED
  MUTED
  AUTO_STARTED
}

enum DiskSourceType {
  SERVER
  AGENT
}

enum AgentDeviceStatus {
  ONLINE
  OFFLINE
  DISABLED
}

model Disk {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  rootPath         String
  description      String?
  status           DiskStatus     @default(ACTIVE)
  isEnabled        Boolean        @default(true)
  lastScanAt       DateTime?
  lastFullScanAt   DateTime?
  lastDiffScanAt   DateTime?
  lastActivityAt   DateTime?
  lastTreeSnapshot Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceType       DiskSourceType @default(SERVER)
  agentDeviceId    String?
  sourceLabel      String?
  remoteDiskKey    String?
  lastSeenAt       DateTime?
  agentDevice      AgentDevice?   @relation(fields: [agentDeviceId], references: [id], onDelete: SetNull)

agentCommands AgentCommand[]
  entries          FileEntry[]
  scanJobs         ScanJob[]
  activities       DiskActivity[]

  automationPreference DiskAutomationPreference?
  automationEvents     AutomationEvent[]

  @@unique([agentDeviceId, remoteDiskKey])
  @@index([status])
  @@index([isEnabled])
  @@index([rootPath])
}

model FileEntry {
  id            String      @id @default(cuid())
  diskId        String
  parentId      String?
  entryType     EntryType
  name          String
  relativePath  String
  fullPath      String
  extension     String?
  size          BigInt?
  modifiedAt    DateTime?
  inode         String?
  fingerprint   String?
  metadata      Json?
  checksum      String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  disk          Disk        @relation(fields: [diskId], references: [id], onDelete: Cascade)
  parent        FileEntry?  @relation("EntryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      FileEntry[] @relation("EntryChildren")

  @@unique([diskId, relativePath])
  @@index([diskId, entryType])
  @@index([diskId, name])
  @@index([diskId, deletedAt])
  @@index([diskId, fingerprint])
  @@index([diskId, inode])
  @@index([parentId])
}

model ScanJob {
  id              String      @id @default(cuid())
  diskId          String
  scanType        ScanType
  status          ScanStatus  @default(PENDING)
  startedAt       DateTime?
  finishedAt      DateTime?
  summary         Json?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  progressPercent Int         @default(0)
  processedItems  Int         @default(0)
  totalItems      Int         @default(0)
  phase           String?
  currentPath     String?

  disk            Disk           @relation(fields: [diskId], references: [id], onDelete: Cascade)
  activities      DiskActivity[]

  @@index([diskId, createdAt])
  @@index([status])
}

model DiskActivity {
  id            String       @id @default(cuid())
  diskId         String
  scanJobId      String?
  activityType   ActivityType
  path           String
  previousPath   String?
  details        Json?
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  disk           Disk         @relation(fields: [diskId], references: [id], onDelete: Cascade)
  scanJob        ScanJob?     @relation(fields: [scanJobId], references: [id], onDelete: SetNull)

  @@index([diskId, acknowledgedAt])
  @@index([createdAt])
  @@index([activityType])
}

model AutomationSettings {
  id                          Int      @id
  isEnabled                   Boolean  @default(true)
  detectNewDisks              Boolean  @default(true)
  watchIndexedDisks           Boolean  @default(true)
  confirmBeforeUpdate         Boolean  @default(true)
  autoUpdateWithoutPrompt     Boolean  @default(false)
  showSystemNotifications     Boolean  @default(true)
  ignoredRoots                Json?
  ignoredPathPatterns         Json?
  notificationCooldownSeconds Int      @default(30)
  changeDebounceSeconds       Int      @default(8)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model DiskAutomationPreference {
  id                      String   @id @default(cuid())
  diskId                  String   @unique
  monitorEnabled          Boolean  @default(true)
  notifyOnConnect         Boolean  @default(true)
  notifyOnChange          Boolean  @default(true)
  autoUpdateWithoutPrompt Boolean  @default(false)
  muted                   Boolean  @default(false)
  ignoredPaths            Json?
  lastPromptAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  disk                    Disk     @relation(fields: [diskId], references: [id], onDelete: Cascade)
}

model AutomationEvent {
  id             String                @id @default(cuid())
  diskId         String?
  eventType      AutomationEventType
  title          String
  message        String
  payload        Json?
  isRead         Boolean               @default(false)
  isDismissed    Boolean               @default(false)
  requiresAction Boolean               @default(true)
  actionState    AutomationActionState @default(PENDING)
  dedupeKey      String?
  createdAt      DateTime              @default(now())
  actedAt        DateTime?

  disk           Disk?                 @relation(fields: [diskId], references: [id], onDelete: SetNull)

  @@index([diskId, createdAt])
  @@index([isDismissed, createdAt])
}

model AgentDevice {
  id              String            @id @default(cuid())
  machineId       String            @unique
  hostName        String
  userLabel       String?
  osName          String?
  appVersion      String?
  status          AgentDeviceStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastHeartbeatAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
commands AgentCommand[]
  disks           Disk[]
  authTokens      AgentAuthToken[]
  availableDisks  AgentAvailableDisk[]
}

model AgentAuthToken {
  id            String      @id @default(cuid())
  agentDeviceId String
  tokenHash     String      @unique
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?

  agentDevice   AgentDevice @relation(fields: [agentDeviceId], references: [id], onDelete: Cascade)
}

model AgentAvailableDisk {
  id            String      @id @default(cuid())
  agentDeviceId String
  remoteDiskKey String
  rootPath      String
  displayName   String
  driveType     String?
  isRemovable   Boolean     @default(false)
  isConnected   Boolean     @default(true)
  lastSeenAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  agentDevice   AgentDevice @relation(fields: [agentDeviceId], references: [id], onDelete: Cascade)

  @@unique([agentDeviceId, remoteDiskKey])
  @@index([agentDeviceId, isConnected])
}

enum AgentCommandType {
  FULL_SCAN
  DIFFERENTIAL_SCAN
  REFRESH_AVAILABLE_DISKS
}

enum AgentCommandStatus {
  PENDING
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model AgentCommand {
  id              String             @id @default(cuid())
  agentDeviceId   String
  diskId          String?
  commandType     AgentCommandType
  status          AgentCommandStatus @default(PENDING)
  payload         Json?
  progressPercent Int                @default(0)
  phase           String?
  currentPath     String?
  result          Json?
  errorMessage    String?
  claimedAt       DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  agentDevice     AgentDevice        @relation(fields: [agentDeviceId], references: [id], onDelete: Cascade)
  disk            Disk?              @relation(fields: [diskId], references: [id], onDelete: SetNull)

  @@index([agentDeviceId, status, createdAt])
  @@index([diskId, createdAt])
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}