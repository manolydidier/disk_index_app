# Config for a machine that only runs the scan agent (npm run agent:start),
# not the web app itself — e.g. every client machine once the server runs
# on its own box (see "Déploiement Docker" in README.md).
#
# Copy this to .env.local in the project folder on that machine:
#   cp .env.agent.example .env.local

# Address of the Disk Indexer server (the machine running Docker), reachable
# from this machine on the network.
AGENT_SERVER_URL="http://192.168.1.50:3000"

# Must match AGENT_REGISTRATION_SECRET on the server exactly — this is what
# lets this agent register itself. Ask whoever deployed the server for it.
AGENT_REGISTRATION_SECRET=""

# Optional — restrict which drives this agent scans, comma/semicolon
# separated (e.g. "D:\;E:\"). Leave empty to auto-detect every drive.
# AGENT_SCAN_ROOTS=""
